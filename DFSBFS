from collections import deque
class Graph:
    def __init__(self, vertices):
        self.vertices = vertices  # number of vertices
        self.graph = {i: [] for i in range(vertices)}  # adjacency list
    # Function to add an edge to the graph (since it's undirected, we add both directions)
    def addEdge(self, u, v):
        self.graph[u].append(v)
        self.graph[v].append(u)
    def DFSRecursive(self, v, visited):
        # Mark the current node as visited
        visited.add(v)
        print(v, end=' ')
        for neighbour in self.graph[v]:
            if neighbour not in visited:
                self.DFSRecursive(neighbour, visited)
    def DFS(self, start):
        visited = set()  # To store visited vertices
        print("DFS Traversal starting from vertex", start)
        self.DFSRecursive(start, visited)
    def BFS(self, start):
        visited = [False] * self.vertices  # To store visited vertices
        queue = deque([start])  # Queue to hold nodes to explore
        visited[start] = True
        print("\nBFS Traversal starting from vertex", start)
        while queue:
            vertex = queue.popleft()
            print(vertex, end=' ')
            for neighbour in self.graph[vertex]:
                if not visited[neighbour]:
                    queue.append(neighbour)
                    visited[neighbour] = True
