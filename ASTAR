def process(self):
    """Main solver function using A* algorithm."""
    print("Enter the start state matrix:")
    start = self.accept()  # Accept the initial state from the user

    print("\nEnter the goal state matrix:")
    goal = self.accept()  # Accept the goal state from the user

    start_node = Node(start, 0, 0)  # Create the start node with the initial state
    start_node.fval = self.f(start_node, goal)  # Calculate the f-value of the start node
    self.open.append(start_node)  # Add the start node to the open list

    while True:
        cur = self.open[0]  # Get the node with the lowest f-value (A* algorithm)
        print("\nCurrent state with f =", cur.fval)
        for row in cur.data:  # Print the current state of the puzzle
            print(" ".join(row))

        if self.h(cur.data, goal) == 0:  # Goal check
            print("\nGoal state reached!")
            break

        # Generate children (possible moves) from the current state
        for i in cur.generate_child():
            i.fval = self.f(i, goal)  # Calculate the f-value for each child
            self.open.append(i)  # Add the child to the open list

        self.closed.append(cur)  # Add the current node to the closed list
        del self.open[0]  # Remove the current node from the open list

        # Sort the open list based on the f-value
        self.open.sort(key=lambda x: x.fval)
